{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "sortImports": false,
  "sortPackageJson": false,
  "ignorePatterns": [
    "dist/**",
    "build/**",
    "docs/api/**",
    "node_modules/**",
    "CHANGELOG.md",
    "package-lock.json",
    ".claude-plugin/plugin.json",
    ".codex-plugin/plugin.json",
    "_reference/**",
    "third_party/**",
    ".codex-plugin/mcp.json",
    ".gemini/**",
    ".agents/SKILLS.md",
    ".agents/mcp_config.json",
    ".agents/agents/**",
    ".agents/rules/**",
    ".agents/skills/**",
    "Docs-Antigravity/**",
    "Mackie-MainStream-App/**",
    "Mackie-Matrix-App/**"
  ]
}
